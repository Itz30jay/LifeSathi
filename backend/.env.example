# Copy to .env and fill in real values. .env itself is gitignored.

# --- Neon Postgres ---
# Note the "jdbc:" prefix — different from the "postgresql://" URI the Neon
# console/MCP shows you. Same host/db, just the JDBC form Spring expects.
DB_URL=jdbc:postgresql://ep-square-mud-arz0rwej-pooler.c-4.us-west-2.aws.neon.tech/lifesathi?sslmode=require
DB_USERNAME=lifesathi_owner
DB_PASSWORD=replace-with-the-password-from-your-neon-connection-string

# --- Clerk ---
# From Clerk Dashboard > Configure > API Keys > "Frontend API URL"
# (NOT the secret key — this backend never touches Clerk's secret key,
# it only verifies JWTs against the public JWKS).
CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
# Comma-separated list of expected "azp" values once you have a real Clerk
# instance to check this against. Leave blank for now — see SecurityConfig.
CLERK_PERMITTED_ORIGINS=

# --- Firebase (push notifications) ---
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key. Base64-encode the downloaded JSON file before pasting it
# here (e.g. `base64 -i service-account.json`) — a raw multi-line JSON
# blob in an env var is fragile across different shells/hosts.
# Leave blank and push notifications just no-op with a log line (see
# FirebaseConfig) rather than crashing the app.
FIREBASE_SERVICE_ACCOUNT_BASE64=

PORT=8080
