# Copy to .env (gitignored). Expo inlines EXPO_PUBLIC_* vars at build time —
# they end up in the compiled app, so only put genuinely public values here
# (a Clerk *publishable* key is meant to be public; never put a secret key
# in a mobile app).

# Clerk Dashboard > API Keys > Publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Your Spring Boot backend. For a physical device or simulator this cannot
# be "localhost" (that means the device itself, not your laptop) — use your
# machine's LAN IP for local dev, e.g. http://192.168.1.23:8080, or the
# Render URL once deployed.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
